//LIQUIDA  JOB (BANK),'LIQUIDACAO',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* EXEMPLO DIDATICO DE JOB BATCH PARA AMBIENTE Z/OS
//STEP01   EXEC PGM=LIQUIDA
//STEPLIB  DD DISP=SHR,DSN=BANK.COBOL.LOADLIB
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//ARQIN    DD DISP=SHR,DSN=BANK.TRANSACOES.DIARIAS
//ARQREJ   DD DISP=(NEW,CATLG,DELETE),
//            DSN=BANK.TRANSACOES.REJEITADAS(+1),
//            SPACE=(TRK,(5,5),RLSE),UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//ARQRES   DD DISP=(NEW,CATLG,DELETE),
//            DSN=BANK.LIQUIDACAO.RESUMO(+1),
//            SPACE=(TRK,(2,2),RLSE),UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//*
//* EM PRODUCAO, O JOB PODERIA SER ORQUESTRADO POR CONTROL-M
//* E CONTER STEPS DE VALIDACAO, DB2, RESTART E CONCILIACAO.
