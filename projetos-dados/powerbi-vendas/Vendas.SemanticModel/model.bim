        ],
        "measures": [
          {
            "name": "Receita Liquida",
            "expression": "CALCULATE(SUMX(Vendas, Vendas[valor_bruto_centavos] - Vendas[desconto_centavos]), KEEPFILTERS(Vendas[status] = \"Concluida\")) / 100",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Vendas Concluidas",
            "expression": "CALCULATE(COUNTROWS(Vendas), KEEPFILTERS(Vendas[status] = \"Concluida\"))",
            "formatString": "0"
          },
          {
            "name": "Ticket Medio",
            "expression": "DIVIDE([Receita Liquida], [Vendas Concluidas])",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Unidades Vendidas",
            "expression": "CALCULATE(SUM(Vendas[quantidade]), KEEPFILTERS(Vendas[status] = \"Concluida\"))",
            "formatString": "0"
          },
          {
            "name": "Taxa Cancelamento",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Vendas), KEEPFILTERS(Vendas[status] = \"Cancelada\")), COUNTROWS(Vendas))",
            "formatString": "0.0%"
          }
        ]
      },
