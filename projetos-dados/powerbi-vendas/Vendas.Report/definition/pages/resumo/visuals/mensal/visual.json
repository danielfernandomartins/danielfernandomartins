{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "mensal",
  "position": {
    "x": 20,
    "y": 180,
    "width": 600,
    "height": 300,
    "z": 0,
    "tabOrder": 200
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario"
                    }
                  },
                  "Property": "mes"
                }
              },
              "queryRef": "Calendario.mes",
              "nativeQueryRef": "mes"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendas"
                    }
                  },
                  "Property": "Receita Liquida"
                }
              },
              "queryRef": "Vendas.Receita Liquida",
              "nativeQueryRef": "Receita Liquida"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
