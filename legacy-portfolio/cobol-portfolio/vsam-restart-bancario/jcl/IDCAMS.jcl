//IDCAMS   JOB (BANK),'VSAM SETUP',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* LABORATORIO Z/OS - NAO EXECUTADO EM AMBIENTE PRODUTIVO
//STEP01   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE DFM.BANK.CLIENTES.KSDS CLUSTER PURGE
  IF MAXCC = 8 THEN SET MAXCC = 0

  DEFINE CLUSTER (
      NAME(DFM.BANK.CLIENTES.KSDS) -
      INDEXED -
      KEYS(6 0) -
      RECORDSIZE(48 48) -
      FREESPACE(10 10) -
      SHAREOPTIONS(2 3)) -
    DATA  (NAME(DFM.BANK.CLIENTES.KSDS.DATA)) -
    INDEX (NAME(DFM.BANK.CLIENTES.KSDS.INDEX))
/*
